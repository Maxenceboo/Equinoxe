{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "generate": "openapi-generator-cli generate --generator-key api && node scripts/schemas.mjs && node scripts/version.mjs",
    "prestart": "npm run generate",
    "start": "ng serve",
    "prebuild": "npm run generate",
    "build": "ng build",
    "pretest": "npm run generate",
    "test": "ng test --watch=false",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ng": "ng"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@ngx-formly/core": "^7.1.0",
    "@ngx-formly/primeng": "^7.1.0",
    "@primeuix/themes": "^2.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "primeicons": "^8.0.2",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
