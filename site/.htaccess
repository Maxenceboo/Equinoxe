AddType application/vnd.android.package-archive .apk
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <Files "version.json">
    Header set Access-Control-Allow-Origin "*"
  </Files>
</IfModule>
